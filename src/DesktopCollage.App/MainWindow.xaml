<Window x:Class="DesktopCollage.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DesktopCollage Phase 1" Width="460" Height="320" MinWidth="240" MinHeight="160" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" Loaded="OnLoaded" Closing="OnClosing" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
<Border Background="#08000000" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="14" Margin="7"><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border HorizontalAlignment="Left" CornerRadius="13" Background="#B03C526C" Margin="10" Padding="14,9" MouseLeftButtonDown="DragHeader"><TextBlock Text="DEVELOPMENT" Foreground="White" FontWeight="SemiBold"/></Border>
<StackPanel Grid.Row="1" Margin="17,10,17,5"><TextBlock Foreground="White" TextWrapping="Wrap" Text="Drag the label to move. Resize the window. Drop files and shortcuts to add references."/><ListBox x:Name="Items" Margin="0,12,0,0" Background="Transparent" Foreground="White" BorderThickness="0" MouseDoubleClick="OpenItem"/></StackPanel>
<Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Margin="0,0,14,12" Click="CloseClick"/>
</Grid></Border></Window>