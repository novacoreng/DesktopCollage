<Window x:Class="DesktopCollage.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" Title="DesktopCollage" Width="520" Height="350" MinWidth="320" MinHeight="220" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" Loaded="OnLoaded" Closing="OnClosing" Activated="OnCompanionActivated" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#29433F"/><Setter Property="Foreground" Value="#E8FFF3"/><Setter Property="BorderBrush" Value="#507D72"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
</Window.Resources>
<Window.CommandBindings><CommandBinding Command="ApplicationCommands.Properties" Executed="RestoreShortcut"/></Window.CommandBindings>
<Window.InputBindings><KeyBinding Command="ApplicationCommands.Properties" Key="R" Modifiers="Control+Shift"/></Window.InputBindings>
<Border Background="#DF101820" BorderBrush="#7993E5B6" BorderThickness="1" CornerRadius="20" Margin="7">
<Grid Margin="13">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border CornerRadius="12" Background="#A3224743" Padding="14,11" MouseLeftButtonDown="DragHeader">
<StackPanel><TextBlock Text="DESKTOPCOLLAGE" Foreground="#93E5B6" FontSize="16" FontWeight="Bold"/><TextBlock Text="Your desktop. Organized and within reach." Foreground="#D0E7E0" FontSize="11"/></StackPanel>
</Border>
<StackPanel Grid.Row="1" Margin="7,14,7,5">
<TextBlock Foreground="#E6F7F1" TextWrapping="Wrap" Text="Drag files or shortcuts here to create references. Manage multiple collections with Collections."/>
<ListBox x:Name="Items" Margin="0,12,0,0" Background="Transparent" Foreground="White" BorderThickness="0" MouseDoubleClick="OpenItem"/>
</StackPanel>
<DockPanel Grid.Row="2" Margin="0,7,0,0" LastChildFill="False">
<WrapPanel DockPanel.Dock="Left">
<Button Content="Collections" Click="OpenCollections"/>
<Button Content="Inspect" Click="InspectExplorer"/>
<Button x:Name="CompanionButton" Content="Desktop mode (test)" Click="ToggleCompanion"/>
<Button Content="Close" Click="CloseClick"/>
</WrapPanel>
<primitives:Thumb DockPanel.Dock="Right" Width="22" Height="22" Cursor="SizeNWSE" DragDelta="ResizeDelta" ToolTip="Resize collection">
<primitives:Thumb.Template><ControlTemplate TargetType="{x:Type primitives:Thumb}"><Border Background="#6F78A9F4" CornerRadius="5"><TextBlock Text="◢" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border></ControlTemplate></primitives:Thumb.Template>
</primitives:Thumb>
</DockPanel>
</Grid></Border></Window>